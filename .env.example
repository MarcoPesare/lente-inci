# Database PostgreSQL (in locale: docker compose up -d)
DATABASE_URL=postgres://lente:lente@localhost:5432/lente

# Protezione della beta: se impostata, l'app chiede questa password.
# Lascia vuoto per disattivarla in locale.
APP_PASSWORD=
# Stringa casuale lunga, usata per firmare il cookie di accesso.
APP_SECRET=cambia-questa-stringa-con-una-casuale

# Facoltativo: lettura dell'INCI da foto con Claude.
ANTHROPIC_API_KEY=
OCR_MODEL=claude-sonnet-5-5

# Ricerca in tempo reale su Open Beauty Facts per i codici non presenti nel database.
OBF_LIVE_LOOKUP=true
OBF_USER_AGENT=LenteINCI/0.1 (beta; contatto: tua-email@example.com)
